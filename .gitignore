# Release builds (scripts/release.ts)
/dist/

# Rust build output
/target/
**/target/

# JavaScript and Python environments
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# Apple build output
**/.build/
**/DerivedData/
**/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
**/*.xcarchive/
*.p12
*.p8
*.cer
*.cert
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Generated web bundles and local design-tool traces
/apps/*/dist/
/.hallmark/

# Local machine clutter and secrets
.DS_Store
**/.DS_Store
.env
.env.*
!.env.example
!.env.*.example

# Isolated lifetime implementation state and dirty-source recovery copies
/.lifetime-canary/
/.lifetime-recovery/

# CI checks out the private Geist mirror inside the workspace (release.yml)
/geist/
