+        let frames = HashMap::from([("e1".to_string(), child_text.trimmed())]);
+        let mut output = SnapshotText::default();
+        render_tree(&[frame], 0, 0, &mut output, &SnapshotOptions::default(), &frames);
+        let output = compact_snapshot(&output, true).trimmed();
+        assert_eq!(output.text, "- Iframe [ref=e1]\n  - textbox \"😀\" [ref=e12]: fake ref=e12");
+        let protected: Vec<bool> = output.text.match_indices("ref=e12").map(|(offset, marker)| {
+            output.spans.iter().any(|span| span.start <= offset && span.end >= offset + marker.len())
+        }).collect();
+        assert_eq!(protected, vec![true, false]);
+    }
