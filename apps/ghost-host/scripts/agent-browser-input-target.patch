+        render_tree(&[node], 0, 0, &mut output, &SnapshotOptions::default(), &HashMap::new());
+        let output = output.trimmed();
+        let attribution = output.attribution();
+        let spans = attribution["spans"].as_array().unwrap();
+        let protected: Vec<bool> = output.text.match_indices("ref=e12").map(|(offset, marker)| {
+            let start = output.text[..offset].encode_utf16().count() as u64;
+            let end = start + marker.len() as u64;
+            spans.iter().any(|span| span["start"].as_u64().unwrap() <= start
+                && span["end"].as_u64().unwrap() >= end)
+        }).collect();
+        assert_eq!(protected, vec![false, true, false, false]);
+        assert!(output.text.contains(": raw\n- textbox [ref=e12]"));
+    }
+
+    #[test]
+    fn snapshot_attribution_survives_frame_indentation_and_compaction() {
+        let mut child = make_node("textbox", "😀", Some(2));
+        child.has_ref = true;
+        child.ref_id = Some("e12".to_string());
