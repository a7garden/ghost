+#[derive(Clone, Copy, serde::Serialize)]
+struct SnapshotSpan {
+    start: usize,
+    end: usize,
+}
+
+/// Renderer-owned ranges use byte offsets internally so trimming, indentation
+/// and compaction can copy text and its provenance together without reparsing it.
+#[derive(Default)]
+pub struct SnapshotText {
+    pub text: String,
+    spans: Vec<SnapshotSpan>,
+}
+
+impl SnapshotText {
+    fn push(&mut self, text: &str, structural: bool) {
+        let start = self.text.len();
+        self.text.push_str(text);
+        if structural && self.text.len() > start {
+            if let Some(last) = self.spans.last_mut() {
+                if last.end == start {
+                    last.end = self.text.len();
+                    return;
+                }
+            }
+            self.spans.push(SnapshotSpan { start, end: self.text.len() });
+        }
+    }
+
+    fn append_range(&mut self, source: &Self, start: usize, end: usize, cursor: &mut usize) {
+        let base = self.text.len();
+        self.push(&source.text[start..end], false);
+        while let Some(span) = source.spans.get(*cursor) {
+            if span.start >= end {
+                break;
+            }
+            if span.end > start {
+                self.spans.push(SnapshotSpan {
+                    start: base + span.start.max(start) - start,
+                    end: base + span.end.min(end) - start,
+                });
+            }
+            if span.end > end {
+                break;
+            }
+            *cursor += 1;
+        }
+    }
+
+    fn append_indented(&mut self, source: &Self, prefix: &str) {
+        let mut offset = 0;
+        let mut cursor = 0;
+        for line in source.text.lines() {
+            self.push(prefix, true);
+            self.append_range(source, offset, offset + line.len(), &mut cursor);
+            self.push("\n", true);
+            offset += line.len();
+            if source.text.as_bytes().get(offset) == Some(&b'\r') { offset += 1; }
+            if source.text.as_bytes().get(offset) == Some(&b'\n') { offset += 1; }
+        }
+    }
+
+    fn trimmed(self) -> Self {
+        let start = self.text.len() - self.text.trim_start().len();
+        let end = self.text.trim_end().len().max(start);
+        let mut output = Self::default();
+        output.append_range(&self, start, end, &mut 0);
+        output
+    }
+
+    pub fn attribution(&self) -> Value {
+        // One forward pass converts disjoint byte ranges to JS UTF-16 offsets.
+        let mut spans = Vec::with_capacity(self.spans.len());
+        let mut byte_offset = 0;
+        let mut utf16_offset = 0;
+        for span in &self.spans {
+            utf16_offset += self.text[byte_offset..span.start].encode_utf16().count();
+            let start = utf16_offset;
+            utf16_offset += self.text[span.start..span.end].encode_utf16().count();
+            spans.push(SnapshotSpan { start, end: utf16_offset });
+            byte_offset = span.end;
+        }
+        serde_json::json!({ "version": 1, "spans": spans })
+    }
+}
