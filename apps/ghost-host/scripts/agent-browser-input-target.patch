+        let mut child_text = SnapshotText::default();
+        render_tree(&[child], 0, 0, &mut child_text, &SnapshotOptions::default(), &HashMap::new());
+        let mut frame = make_node("Iframe", "", Some(1));
+        frame.has_ref = true;
