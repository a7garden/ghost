(version 1)
(allow default)
(deny network*)
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny file-read* file-write*
  (subpath "/Users/garden/.config/mcp")
  (subpath "/Users/garden/.config/oxicode")
  (subpath "/Users/garden/Library/Application Support/mcp")
  (subpath "/Users/garden/Library/Application Support/oxicode")
  (subpath "/Users/garden/.omp")
  (subpath "/Users/garden/.codex")
  (subpath "/Users/garden/Documents/Workspace/Projects/ghost/.mcp.json")
  (subpath "/Users/garden/Documents/Workspace/Projects/ghost/.oxicode")
  (subpath "/Users/garden/Documents/Workspace/Projects/ghost/.claude")
  (subpath "/Users/garden/Documents/Workspace/Projects/ghost/.cursor")
)
