[Unit]
Description=Ghost durable host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghost
Group=ghost
UMask=0077
EnvironmentFile=/etc/ghost/host.env
ExecStart=/opt/ghost/bin/ghost --root /var/lib/ghost serve --headless
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
