GHOST_ROOT=/var/lib/ghost
GHOST_GATEWAY_DEVICES=/etc/ghost/devices.json
GHOST_GATEWAY_ORIGIN=https://ghost.example.com
GHOST_GATEWAY_PORT=8788

# Streaming media binding (native iPhone calls). Values must match the
# serve_streaming.py launch of the same conversation.
#GHOST_VOICE_MEDIA_ORIGIN=http://127.0.0.1:62077
#GHOST_VOICE_CONTROL_TOKEN=
#GHOST_VOICE_GHOST_ID=
#GHOST_VOICE_CONVERSATION_ID=

# APNs alert delivery for the durable notification outbox. Missing values
# disable sending only; inbox reads and acknowledgements keep working.
#GHOST_APNS_KEY_PATH=
#GHOST_APNS_KEY_ID=
#GHOST_APNS_TEAM_ID=
#GHOST_APNS_TOPIC=io.a7garden.ghost
#GHOST_APNS_ENVIRONMENT=sandbox
